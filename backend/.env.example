# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Vision model. Verified in Groq's docs on 2026-11-14 (image input + JSON mode).
# It is a PREVIEW model, so re-check Groq's model list if requests start failing.
# Leave empty to use the built-in default (qwen/qwen3.8-27b).
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=1

MAX_UPLOAD_MB=15
MAX_RETRIES=2
PROCESSING_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Company networks that inspect HTTPS: keep this true (uses the Windows certificate store).
GROQ_USE_SYSTEM_CERTS=true
# Optional: path to your company's root certificate (.pem/.crt) if the above is not enough.
GROQ_CA_BUNDLE=
